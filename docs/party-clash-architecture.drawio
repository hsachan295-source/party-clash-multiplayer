<mxfile host="drawio" agent="party-clash generator" version="24.7.17"><diagram id="party-clash-architecture" name="Architecture &amp; Game Flow"><mxGraphModel dx="2370" dy="1370" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2370" pageHeight="1370" background="#07081a" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#07081a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2370" height="1370" as="geometry"/></mxCell><mxCell id="title" value="Party Clash: After Hours Trivia  —  Architecture &amp; Game Flow" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#ffffff;fontSize=28;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="As implemented: Vite + vanilla TypeScript frontend  ·  one Netlify Function (POST /.netlify/functions/game)  ·  Netlify Blobs room state  ·  2–8 players per room" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#a9acd0;fontSize=15;fontStyle=0;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1700" height="26" as="geometry"/></mxCell><mxCell id="legend1" value="━━  request / response" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#facc15;fontSize=13;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1820" y="22" width="500" height="22" as="geometry"/></mxCell><mxCell id="legend2" value="┅┅  synchronized state (polling) / game loop" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#c6ff3d;fontSize=13;fontStyle=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1820" y="46" width="520" height="22" as="geometry"/></mxCell><mxCell id="g_dev" value="PLAYER DEVICES" style="rounded=1;arcSize=3;html=0;fillColor=#0f1130;strokeColor=#c6ff3d;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#c6ff3d;fontStyle=1;fontSize=17;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="340" height="730" as="geometry"/></mxCell><mxCell id="dev_host" value="Host browser (desktop or phone)&#xa;Creates the room, gets the 4-letter code&#xa;and host controls: Start / Play Again" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#c6ff3d;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="54" y="150" width="312" height="92" as="geometry"/></mxCell><mxCell id="dev_p2" value="Player 2 browser (phone or desktop)&#xa;Joins with room code + nickname&#xa;or the invite link  ?room=CODE" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#c6ff3d;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="54" y="258" width="312" height="92" as="geometry"/></mxCell><mxCell id="dev_more" value="Players 3 … 8 browsers&#xa;Same join flow — max 8 per room&#xa;Join only while the room is in the lobby" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#c6ff3d;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="54" y="366" width="312" height="92" as="geometry"/></mxCell><mxCell id="dev_note" value="Separate devices, separate identities&#xa;Each browser keeps its own session&#xa;in localStorage — no accounts, no login" style="rounded=1;arcSize=10;html=0;fillColor=#141633;strokeColor=#c6ff3d;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="54" y="474" width="312" height="92" as="geometry"/></mxCell><mxCell id="dev_mobile" value="Mobile-first responsive UI&#xa;Phones from 360 px wide up to desktop;&#xa;large tap targets, no horizontal scroll" style="rounded=1;arcSize=10;html=0;fillColor=#141633;strokeColor=#c6ff3d;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="54" y="582" width="312" height="92" as="geometry"/></mxCell><mxCell id="dev_same" value="Every player sees the same lobby,&#xa;question, countdown, results,&#xa;leaderboard and winner" style="rounded=1;arcSize=10;html=0;fillColor=#141633;strokeColor=#c6ff3d;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="54" y="690" width="312" height="92" as="geometry"/></mxCell><mxCell id="g_fe" value="FRONTEND   src/main.ts · styles.css" style="rounded=1;arcSize=3;html=0;fillColor=#0f1130;strokeColor=#a78bfa;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#a78bfa;fontStyle=1;fontSize=17;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="340" height="730" as="geometry"/></mxCell><mxCell id="fe_land" value="Landing — Create Room / Join Room" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="148" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_create" value="Create Room — host nickname" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="215" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_join" value="Join Room — code + nickname, clear errors" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="282" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_lobby" value="Lobby — code tiles, players n/8, host Start" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="349" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_rules" value="How to Play — rules modal on every screen" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="416" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_round" value="Trivia round — get ready, 15 s timer, 4 options" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="483" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_answer" value="Answer submission — one tap, then Locked" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="550" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_results" value="Round results — correct answer, who picked what" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="617" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_board" value="Leaderboard — +points this round, ranking" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="684" width="312" height="56" as="geometry"/></mxCell><mxCell id="fe_final" value="Final winner — podium, standings, Play Again" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#a78bfa;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="444" y="751" width="312" height="56" as="geometry"/></mxCell><mxCell id="g_cs" value="CLIENT STATE" style="rounded=1;arcSize=3;html=0;fillColor=#0f1130;strokeColor=#22d3ee;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#22d3ee;fontStyle=1;fontSize=17;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="340" height="730" as="geometry"/></mxCell><mxCell id="cs_session" value="src/session.ts — player/session identity&#xa;localStorage: room code, playerId,&#xa;secret token, nickname" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#22d3ee;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="834" y="150" width="312" height="92" as="geometry"/></mxCell><mxCell id="cs_code" value="Room code&#xa;Shown in lobby + kept in the URL ?room=CODE&#xa;(Copy invite link)" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#22d3ee;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="834" y="258" width="312" height="92" as="geometry"/></mxCell><mxCell id="cs_api" value="src/api.ts — API client&#xa;POST JSON to /.netlify/functions/game;&#xa;estimates server clock offset for countdowns" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#22d3ee;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="834" y="366" width="312" height="92" as="geometry"/></mxCell><mxCell id="cs_poll" value="Polling / synchronization&#xa;'state' every 0.8 s (question) / 1 s,&#xa;4 s in a hidden tab; re-render on change" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#22d3ee;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="834" y="474" width="312" height="92" as="geometry"/></mxCell><mxCell id="cs_refresh" value="Refresh recovery&#xa;On reload the saved session calls 'state' →&#xa;same seat, score and locked-in answer" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#22d3ee;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="834" y="582" width="312" height="92" as="geometry"/></mxCell><mxCell id="cs_err" value="Connection handling&#xa;Network error → 'Reconnecting…' banner;&#xa;NOT_IN_ROOM / NO_ROOM → back to home" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#22d3ee;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="834" y="690" width="312" height="92" as="geometry"/></mxCell><mxCell id="g_api" value="API LAYER   server/handler.ts" style="rounded=1;arcSize=3;html=0;fillColor=#0f1130;strokeColor=#facc15;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#facc15;fontStyle=1;fontSize=17;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="340" height="730" as="geometry"/></mxCell><mxCell id="api_ep" value="POST /.netlify/functions/game&#xa;One endpoint · JSON body { action, … }" style="rounded=1;arcSize=10;html=0;fillColor=#2a2610;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="148" width="312" height="62" as="geometry"/></mxCell><mxCell id="api_val" value="Request validation&#xa;POST only, ≤ 2 KB JSON, known action,&#xa;4-letter code, playerId + secret token" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="222" width="312" height="80" as="geometry"/></mxCell><mxCell id="api_create" value="create — room actions: new room, unique code" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="314" width="312" height="46" as="geometry"/></mxCell><mxCell id="api_join" value="join — join actions: name rules, 2–8 cap" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="368" width="312" height="46" as="geometry"/></mxCell><mxCell id="api_start" value="start — start game (host only, ≥ 2 players)" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="422" width="312" height="46" as="geometry"/></mxCell><mxCell id="api_state" value="state — get game state (poll + heartbeat)" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="476" width="312" height="46" as="geometry"/></mxCell><mxCell id="api_answer" value="answer — submit answer { round, choice }" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="530" width="312" height="46" as="geometry"/></mxCell><mxCell id="api_rematch" value="rematch / leave — rematch (host), leave room" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="584" width="312" height="46" as="geometry"/></mxCell><mxCell id="api_mutate" value="mutate(): read → apply rules → conditional&#xa;write; on ETag conflict re-read &amp; retry&#xa;(up to 12×, jittered backoff)" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="644" width="312" height="80" as="geometry"/></mxCell><mxCell id="api_resp" value="Response: public room view JSON&#xa;or { ok: false, error, code } + HTTP status" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#facc15;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1224" y="736" width="312" height="62" as="geometry"/></mxCell><mxCell id="g_be" value="BACKEND   netlify/functions/game.ts" style="rounded=1;arcSize=3;html=0;fillColor=#0f1130;strokeColor=#f472b6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#f472b6;fontStyle=1;fontSize=17;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1600" y="100" width="340" height="488" as="geometry"/></mxCell><mxCell id="be_state" value="server/logic.ts — authoritative game state&#xa;One RoomState per room; clients only send intent" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#f472b6;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1614" y="146" width="312" height="44" as="geometry"/></mxCell><mxCell id="be_time" value="advance() — server-side timing / round transitions&#xa;lead-in 3.5 s / 2.5 s · question 15 s · reveal 6 s;&#xa;closes early when every connected player answered" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#f472b6;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1614" y="202" width="312" height="62" as="geometry"/></mxCell><mxCell id="be_dup" value="submitAnswer() — duplicate submission protection&#xa;rejects duplicate, late (300 ms grace), early,&#xa;invalid choice, wrong round" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#f472b6;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1614" y="278" width="312" height="62" as="geometry"/></mxCell><mxCell id="be_score" value="closeQuestion() — server-side scoring&#xa;500 + up to 500 speed bonus; wrong / none = 0" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#f472b6;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1614" y="354" width="312" height="46" as="geometry"/></mxCell><mxCell id="be_rank" value="ranking() — winner &amp; tie-breakers&#xa;score → most correct → fastest time → shared win" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#f472b6;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1614" y="414" width="312" height="46" as="geometry"/></mxCell><mxCell id="be_host" value="Host authorization: start / rematch host-only;&#xa;host hand-off after 20 s away" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#f472b6;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1614" y="474" width="312" height="46" as="geometry"/></mxCell><mxCell id="be_pub" value="toPublic() — hides correct answer, others' picks&#xa;and tokens until the round is revealed" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#f472b6;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1614" y="534" width="312" height="46" as="geometry"/></mxCell><mxCell id="g_gc" value="GAME CONTENT   server/questions.ts" style="rounded=1;arcSize=3;html=0;fillColor=#0f1130;strokeColor=#fb923c;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#fb923c;fontStyle=1;fontSize=17;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1600" y="624" width="340" height="206" as="geometry"/></mxCell><mxCell id="gc_bank" value="Built-in trivia question bank&#xa;88 questions · 10 categories · 4 options each&#xa;Server-only — never sent in the browser bundle" style="rounded=1;arcSize=10;html=0;fillColor=#1a1d45;strokeColor=#fb923c;strokeOpacity=70;fontColor=#f5f5ff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="1614" y="664" width="312" height="66" as="geometry"/></mxCell><mxCell id="